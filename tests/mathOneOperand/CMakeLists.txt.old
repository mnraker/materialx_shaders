add_custom_command(
	OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/scene.rdla
	COMMAND echo "PYTHONPATH=$ENV{PYTHONPATH}"
	COMMAND ${CMAKE_COMMAND} -E env "PYTHONPATH=${CMAKE_BINARY_DIR}/mod/python:$ENV{PYTHONPATH}" python ${CMAKE_CURRENT_SOURCE_DIR}/Test_one_operand.py -o ${CMAKE_CURRENT_BINARY_DIR}/scene.usda
	COMMAND python ${CMAKE_CURRENT_SOURCE_DIR}/Test_one_operand.py -o ${CMAKE_CURRENT_BINARY_DIR}/scene.usda
	COMMAND hd_usd2rdl -in ${CMAKE_CURRENT_BINARY_DIR}/Test_one_operand.usda -out ${CMAKE_CURRENT_BINARY_DIR}/scene.rdla
    COMMENT "Generating scene.rdla from Test_one_operand.py"
	DEPENDS Test_one_operand.py
	DEPENDS shaders
)

add_custom_target(
	Test_one_operand ALL
	DEPENDS ${CMAKE_CURRENT_BINARY_DIR}/scene.rdla
)

add_rats_test(
    INPUTS ${CMAKE_CURRENT_BINARY_DIR}/scene.rdla
	CANONICALS scene.exr
)
