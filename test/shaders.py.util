import pxr
from pxr import Gf, Kind, Usd, Sdf, UsdGeom, UsdShade
#import pxr.UsdUtils.fixBrokenPixarSchemas
#import materialx_shaders

def HandleShaderAttribute(shader, attrName, attrValue, attrType, bindable=False):
    if isinstance(attrValue, pxr.UsdShade.Shader):
        if bindable:
            shader.CreateInput(attrName, attrType).ConnectToSource(attrValue.ConnectableAPI(), 'out')
        else:
            print('Warning: {}.{} cannot be bound (ignoring)'.format(shader.GetShaderId(),attrName))
    elif attrValue!=None:
        shader.CreateInput(attrName, attrType).Set(attrValue)

def HandleShaderAttributeValue(shader, attrName, attrValue, attrType):
    if attrValue:
        shader.CreateInput(attrName, attrType).Set(attrValue)

#
# extract the name of an object if one is provided and append the name
#
def HandlePath(path, name):
    # if the path is an object then convert it into a string
    if isinstance(path, pxr.Usd.SchemaBase):
        path=path.GetPath().pathString
    path = path + '/' + name

    return path

def create_UsdPreviewSurface( stage, path, name, diffuseColor=None,
    emissiveColor=None,
    useSpecularWorkflow=None,
    specularColor=None,
    metallic=None,
    roughness=None,
    clearcoat=None,
    clearcoatRoughness=None,
    opacity=None,
    opacityThreshold=None,
    ior=None,
    normal=None,
    displacement=None,
    occlusion=None):

    shader = UsdShade.Shader.Define(stage, HandlePath(path,name))
    shader.CreateIdAttr('UsdPreviewSurface')

    HandleShaderAttribute(shader, 'diffuseColor', diffuseColor, Sdf.ValueTypeNames.Float3, bindable=True)
    HandleShaderAttribute(shader, 'emissiveColor', emissiveColor, Sdf.ValueTypeNames.Float3, bindable=True)
    HandleShaderAttribute(shader, 'useSpecularWorkflow', useSpecularWorkflow, Sdf.ValueTypeNames.Int)
    HandleShaderAttribute(shader, 'specularColor', specularColor, Sdf.ValueTypeNames.Float3)
    HandleShaderAttribute(shader, 'metallic', metallic, Sdf.ValueTypeNames.Float, bindable=True)
    HandleShaderAttribute(shader, 'roughness', roughness, Sdf.ValueTypeNames.Float, bindable=True)
    HandleShaderAttribute(shader, 'clearcoat', clearcoat, Sdf.ValueTypeNames.Float, bindable=True)
    HandleShaderAttribute(shader, 'clearcoatRoughness', clearcoatRoughness, Sdf.ValueTypeNames.Float, bindable=True)
    HandleShaderAttribute(shader, 'opacity', opacity, Sdf.ValueTypeNames.Float, bindable=True)
    HandleShaderAttribute(shader, 'opacityThreshold', opacityThreshold, Sdf.ValueTypeNames.Float, bindable=True)
    HandleShaderAttribute(shader, 'ior', ior, Sdf.ValueTypeNames.Float, bindable=True)
    HandleShaderAttribute(shader, 'normal', normal, Sdf.ValueTypeNames.Float3, bindable=True)
    HandleShaderAttribute(shader, 'displacement', displacement, Sdf.ValueTypeNames.Float, bindable=True)
    HandleShaderAttribute(shader, 'occlusion', occlusion, Sdf.ValueTypeNames.Float, bindable=True)

    shader.CreateOutput('out', Sdf.ValueTypeNames.Token)
    return shader

def create_MeshCube(stage, path, name, size, x, y, z):
    path=HandlePath(path,name)
    meshPrim = UsdGeom.Mesh.Define(stage, path)
    prim = stage.GetPrimAtPath(path);
    prim.ApplyAPI(UsdShade.MaterialBindingAPI)
    meshPrim.CreatePointsAttr([
        ( size+x,  size+y,  size+z),
        (-size+x,  size+y,  size+z),
        (-size+x, -size+y,  size+z),
        ( size+x, -size+y,  size+z),
        (-size+x, -size+y, -size+z),
        (-size+x,  size+y, -size+z),
        ( size+x,  size+y, -size+z),
        ( size+x, -size+y, -size+z)])
    meshPrim.CreateFaceVertexCountsAttr([4, 4, 4, 4, 4, 4])
    meshPrim.CreateFaceVertexIndicesAttr([0, 1, 2, 3, 4, 5, 6, 7, 4, 7, 3, 2, 0, 3, 7, 6, 4, 2, 1, 5, 6, 5, 1, 0])
    meshPrim.CreateExtentAttr([(-1, -1, -1), (1, 1, 1)])
    meshPrim.CreateSubdivisionSchemeAttr('none')

    return meshPrim

def create_Sphere(stage,path,name):
    path = HandlePath(path,name)
    spherePrim = UsdGeom.Sphere.Define(stage, path)
    prim = stage.GetPrimAtPath(path);
    prim.ApplyAPI(UsdShade.MaterialBindingAPI)

    return spherePrim
